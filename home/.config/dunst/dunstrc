# dunst :: AMBER-76 (no transparency, no fades)
[global]
    monitor = 0
    follow = keyboard
    width = (240, 340)
    height = (0, 220)
    origin = top-right
    offset = (10, 30)
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 200
    progress_bar_max_width = 320
    progress_bar_corner_radius = 0
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 8
    horizontal_padding = 10
    text_icon_padding = 8
    frame_width = 2
    frame_color = "#ffb000"
    separator_color = frame
    gap_size = 4
    sort = yes
    font = Terminess Nerd Font 10.5
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 0
    max_icon_size = 48
    sticky_history = yes
    history_length = 30
    browser = /usr/bin/xdg-open
    always_run_script = true
    corner_radius = 0
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1c1b19"
    foreground = "#e8dcc0"
    frame_color = "#3e9d9a"
    highlight = "#3e9d9a"
    timeout = 3

[urgency_normal]
    background = "#1c1b19"
    foreground = "#e8dcc0"
    frame_color = "#ffb000"
    highlight = "#ffb000"
    timeout = 6

[urgency_critical]
    background = "#d0453b"
    foreground = "#1c1b19"
    frame_color = "#ffb000"
    highlight = "#1c1b19"
    timeout = 0

[osd]
    appname = osd
    format = "<b>%s</b>"
    highlight = "#ffb000"
    frame_color = "#ffb000"
    history_ignore = yes
    timeout = 2
