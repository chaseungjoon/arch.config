// fastfetch :: AMBER-76
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": { "1": "38;5;214", "2": "38;5;208" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;5;214", "title": "38;5;208", "separator": "38;5;240" },
    "percent": { "type": 9, "color": { "green": "38;5;107", "yellow": "38;5;214", "red": "38;5;167" } }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "\u001b[38;5;240m────────────────────────" },
    { "type": "os",       "key": "OS    ",     "format": "{name} {arch}" },
    { "type": "kernel",   "key": "KERNEL" },
    { "type": "uptime",   "key": "UPTIME" },
    { "type": "packages", "key": "PKGS  " },
    { "type": "shell",    "key": "SHELL " },
    { "type": "wm",       "key": "WM    " },
    { "type": "terminal", "key": "TERM  " },
    { "type": "custom", "format": "\u001b[38;5;240m────────────────────────" },
    { "type": "host",     "key": "HOST  " },
    { "type": "cpu",      "key": "CPU   ", "format": "{name} ({cores-logical})" },
//    { "type": "gpu",      "key": "GPU   ", "format": "{vendor} iGPU ({driver})" },
    { "type": "memory",   "key": "MEM   " },
    { "type": "disk",     "key": "ROOT  ", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "disk",     "key": "HOME  ", "folders": "/home", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "battery",  "key": "BAT   ", "format": "{capacity} {?time-hours}({time-hours}h{time-minutes}m){?}{/time-hours}(AC){/}" },
    "break",
    { "type": "colors", "symbol": "block" }
  ]
}
