#!/usr/bin/env python3
# i3bar workspace_command: workspaces 1-5 are always shown (as placeholders
# when they don't exist yet); any other workspace shows only while it exists.
import json
import sys

import i3ipc

PERSISTENT = range(1, 6)


def emit(i3, _event=None):
    real = i3.get_workspaces()
    taken = {ws.num for ws in real}
    out = [
        {
            "num": ws.num,
            "name": ws.name,
            "focused": ws.focused,
            "visible": ws.visible,
            "urgent": ws.urgent,
            "output": ws.output,
        }
        for ws in real
    ]
    # no "output" key -> i3bar puts it on the primary output
    out += [{"num": n, "name": str(n)} for n in PERSISTENT if n not in taken]
    out.sort(key=lambda ws: (ws["num"] < 0, ws["num"]))
    sys.stdout.write(json.dumps(out) + "\n")
    sys.stdout.flush()


i3 = i3ipc.Connection()
i3.on(i3ipc.Event.WORKSPACE, emit)
i3.on(i3ipc.Event.OUTPUT, emit)
emit(i3)
i3.main()
