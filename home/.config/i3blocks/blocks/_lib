# sourced by every block
AMBER='#ffb000'; FG='#e8dcc0'; DIM='#9a8f7a'; ORANGE='#e8742c'
RED='#d0453b'; GREEN='#8fb339'; TEAL='#3e9d9a'; MUSTARD='#f2c14e'
BTN=${button:-$BLOCK_BUTTON}
# out LABEL VALUE [value-colour]
# out LABEL VALUE [value-colour] -> " LABEL VALUE " (padded so readings sit evenly in a panel)
out() { printf " <span color='%s'>%s</span> <span color='%s'>%s</span> \n" "$DIM" "$1" "${3:-$FG}" "$2"; }
term() { setsid -f kitty --class kitty-float "$@" >/dev/null 2>&1; }
